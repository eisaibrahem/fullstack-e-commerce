# Copy to .env locally. On Vercel: Project → Settings → Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="change-me-in-production"
PORT=3003
# No trailing slashes on origins (must match browser Origin exactly).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://e-commerce-front-by-nest.vercel.app
